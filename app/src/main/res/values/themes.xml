<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.AttendanceModule" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/onPrimary</item>
        <item name="colorPrimaryContainer">@color/primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/onPrimaryContainer</item>

        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/onSecondary</item>
        <item name="colorSecondaryContainer">@color/secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/onSecondaryContainer</item>

        <item name="colorOutline">@color/outline</item>
        <item name="colorOnSurfaceVariant">@color/onSurfaceVariant</item>

        <item name="android:windowBackground">@drawable/bg_main_gradient</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/onSurface</item>
        <item name="android:statusBarColor">@color/primary</item>
        <item name="glassBackgroundColor">@color/glass_white</item>
        <item name="glassCardBackground">@drawable/bg_glass_card</item>
    </style>

    <attr name="glassBackgroundColor" format="color" />
    <attr name="glassCardBackground" format="reference" />

    <style name="Theme.AttendanceModule" parent="Base.Theme.AttendanceModule" />

    <style name="ToolbarTheme" parent="ThemeOverlay.MaterialComponents.Toolbar.Primary">
        <item name="actionMenuTextColor">?attr/colorOnSurface</item>
        <item name="colorControlNormal">?attr/colorOnSurface</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.AttendanceModule.SearchBar" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">28dp</item>
        <item name="boxCornerRadiusTopEnd">28dp</item>
        <item name="boxCornerRadiusBottomStart">28dp</item>
        <item name="boxCornerRadiusBottomEnd">28dp</item>
        <item name="boxBackgroundColor">?attr/glassBackgroundColor</item>
        <item name="hintEnabled">true</item>
        <item name="startIconTint">?attr/colorPrimary</item>
        <item name="boxStrokeColor">?attr/colorOutline</item>
        <item name="boxStrokeWidth">1dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.AttendanceModule.DrawerItem" parent="">
        <item name="cornerSize">16dp</item>
    </style>
</resources>
